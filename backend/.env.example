# ==============================================================================
# INSTAGRAM CLONE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Use these environment variables when deploying on Render or setting up locally.
# DO NOT commit your actual .env file to GitHub.

# Server Port
PORT=8000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/instagram_clone?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_uri

# JWT Authentication Secret Key (Any random secure string)
SECRET_KEY=your_jwt_secret_key_here

# Cloudinary Storage Credentials (for image & video uploads)
# Sign up at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini API Key (Pro image transformation & multimodal styling)
# Get from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Secret Key (for Admin-only features like viewing original photos)
ADMIN_SECRET_KEY=your_admin_secret_key_here

# Frontend URL (For CORS allow-list in production)
# Example: https://your-frontend.vercel.app or http://localhost:5173
URL=http://localhost:5173
